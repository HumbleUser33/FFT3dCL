# --- Build outputs ---
build/
out/
*.obj
*.pdb
*.exp
*.log
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/

# --- Local toolchain (Avisynth+, ffmpeg, L-SMASH: third-party binaries) ---
env/

# --- Upstream reference clone (pinterf/FFT3dGPU, kept locally for comparison) ---
