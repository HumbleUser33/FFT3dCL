# because gitignore is case-insensitive on Windows.
/FFT3dGPU/

# --- Editor / agent state ---
.vs/
.agents/
.idea/

# --- Media and test clips (large, never versioned) ---
*.mkv
*.y4m
*.avi
*.lwi
*.pyo
__pycache__/

# --- Scratch files produced while testing (leading underscore) ---
tools/_*
*.yuv

# --- Stray timecode files created by test scripts ---
/1
/8

# Local clone of the upstream reference (kept out of the repo)
/_upstream_ref_FFT3dGPU/
